    { "from": "660e8400-e29b-41d4-a716-446655440013", "to": "660e8400-e29b-41d4-a716-446655440020" },
    { "from": "660e8400-e29b-41d4-a716-446655440020", "to": "660e8400-e29b-41d4-a716-446655440021" },
    { "from": "660e8400-e29b-41d4-a716-446655440020", "to": "660e8400-e29b-41d4-a716-446655440022" },
    { "from": "660e8400-e29b-41d4-a716-446655440021", "to": "660e8400-e29b-41d4-a716-446655440030" },
    { "from": "660e8400-e29b-41d4-a716-446655440022", "to": "660e8400-e29b-41d4-a716-446655440030" },
    { "from": "660e8400-e29b-41d4-a716-446655440030", "to": "660e8400-e29b-41d4-a716-446655440040" }
  ],
  "variables": {
    "input.document_image": "base64_or_path",
    "input.language": "en"
  }
}
