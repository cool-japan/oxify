    { "from": "660e8400-e29b-41d4-a716-446655440003", "to": "660e8400-e29b-41d4-a716-446655440010", "condition": "invoice" },
    { "from": "660e8400-e29b-41d4-a716-446655440003", "to": "660e8400-e29b-41d4-a716-446655440011", "condition": "receipt" },
    { "from": "660e8400-e29b-41d4-a716-446655440003", "to": "660e8400-e29b-41d4-a716-446655440012", "condition": "form" },
    { "from": "660e8400-e29b-41d4-a716-446655440003", "to": "660e8400-e29b-41d4-a716-446655440013", "condition": "default" },
